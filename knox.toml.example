# KNOX configuration reference
# Copy to knox.toml and adjust for your project.
# Full docs: https://knox.readthedocs.io/guides/config.html

# ── Compile settings ────────────────────────────────────────────────────

[compile]
# Input/output directories (relative to cwd)
sources_dir = "sources"
output_dir = "wiki"

# Output format: markdown | json | typst
format = "markdown"

# Chunk size in tokens (atomic elements like tables are never split)
chunk_size = 512

# Image handling: file (extract to disk) | base64 (inline)
image_mode = "file"

# Pipeline mode: full | index-only | resolve-only | output-only
mode = "full"

# Parallel parse workers (1 = sequential)
workers = 1

# Max source chars per concept (prompt budget)
prompt_budget = 200000

# ── Budget settings (expert knobs — config file only, no env/CLI) ──────

[compile.budget]
# Max source chars per extraction LLM call (longer = split + merge)
extract = 6000

# Max source chars per generation segment (longer = iterated)
generate_source_segment = 20000

# Max concepts per generation batch (keeps prompts manageable for small LLMs)
concepts_per_batch = 8

# Max chars per probe-generation LLM call
wicer_probe = 3000

# Max chars per evaluation segment
wicer_eval = 4000

# Max chars per overview-synthesis LLM call
overview = 4000

# Max chars per verification LLM call
verify = 3000

# Minimum n-gram length for fallback substring verification
min_ngram = 3

# Max chars per LLM lint call
lint_page = 100000

# ── LLM settings ────────────────────────────────────────────────────────

[compile.llm]
# Primary model in litellm format ("provider/model")
default_model = "ollama/llama3.2"

# Ordered fallback models tried when the primary fails
# fallback_chain = ["openai/gpt-4o", "anthropic/claude-3-haiku-20240307"]

# Transient-error retries before advancing to next fallback model
fallback_max_retries = 2

# ── Output settings ─────────────────────────────────────────────────────

[compile.output]
# Markdown flavor: obsidian | gfm | mkdocs | mdx | quarto | myst | standard
# Set to auto-detect when omitted.
# flavor = "obsidian"

# Default frontmatter fields added to every page
# [compile.output.frontmatter]
# language = "en"
# domain = "ml"

# ── Lint settings ───────────────────────────────────────────────────────

[lint]
# Rules to run (null = all structural rules)
# enabled = ["broken-wikilinks", "orphan-page", "duplicate-title"]

# Exit with error if health score falls below this threshold
# threshold = 80

# ── Eval settings ───────────────────────────────────────────────────────

[eval]
# CI gate: exit non-zero if score below threshold
# threshold = 80

# Number of historical eval results to keep
history_size = 20

# ── Trust settings ──────────────────────────────────────────────────────

[trust]
# Privacy redaction filter: strip secrets/PII before sources enter the pipeline
# privacy_filter = true

# ── Ignore patterns ─────────────────────────────────────────────────────

[ignore]
# Glob patterns excluded from source discovery
# patterns = ["*.tmp", ".drafts/", "*.bak"]
