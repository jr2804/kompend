# KNOX configuration reference
# Copy to .knox/config.toml or knox.toml and adjust for your project.
# Full docs: https://knox.readthedocs.io/guides/config.html

# ── Paths ────────────────────────────────────────────────────────────────
# All paths are relative to the wiki root (the directory containing
# `.knox/config.toml` or `knox.toml`, or the value of `--wiki-dir`).

[paths]
sources_dir = "sources"
output_dir = "wiki"
cache_dir = ".knox/cache"
state_dir = ".knox"

# ── User notes ──────────────────────────────────────────────────────────
# Free-form context file injected into LLM templates as {{ user_notes }}.
# Knox never modifies this file. Missing file = no error.

[notes]
file = "NOTES.md"

# ── Compile settings ────────────────────────────────────────────────────

[compile]
# Output format: markdown | json | typst
format = "markdown"

# Chunk size in tokens (atomic elements like tables are never split)
chunk_size = 512

# Image handling: file (extract to disk) | base64 (inline)
image_mode = "file"

# Pipeline start tier: index | chunk | resolve | compile | output
# start_at_tier = "index"

# Parallel parse workers (1 = sequential)
workers = 1

# Typed relation extraction during Tier 2 (uses the default LLM model).
# When enabled, the resolver extracts typed relations such as uses/depends_on
# between entities and the compiler emits them as graph edges.
# resolve_relations = false

# Minimum confidence (0.0-1.0) for typed relations to be kept.
# relation_confidence_threshold = 0.0

# ── Memory lifecycle ──────────────────────────────────────────────────────
#
# KNOX tracks a lifecycle state per wiki node across compiles:
#   - confidence (evolves toward 1.0 with each re-compile)
#   - tier (working → episodic → semantic → procedural)
#   - supersession (old nodes replaced by same-title new nodes)
#   - retention/decay (exponential forgetting curve)
# Disabled by default to keep first-run output clean.
# memory_enabled = true
# memory_half_life_days = 90.0
# memory_decay_threshold = 0.3

# ── Budget settings ───────────────────────────────────────────────────────
#
# All budgets are in TOKENS (not characters). Approximate conversion:
# 1 token ≈ 4 characters for English text.
#
# Input sizing is adaptive: the context window is discovered from the
# model at startup (via litellm.get_model_info or Ollama /api/show).
# Chunks fill the available context window, clamped to [chunk_size_min,
# chunk_size_max]. The system NEVER silently truncates input.
#
# Output sizing is adaptive per phase:
#   output_budget = clamp(input_tokens * ratio, output_min, output_max)

[compile.budget]
# Structural controls (not token budgets)
concepts_per_batch = 8         # concepts per generation batch
verify_min_ngram = 3           # minimum n-gram for substring verification
wicer_max_iterations = 3       # max WiCER compile-evaluate-refine iterations

# Chunk sizing safety rails (tokens)
chunk_size_min = 2048          # floor: prevents useless tiny chunks
chunk_size_max = 131072        # ceiling: safety rail for models claiming 1M+ context

# Extraction output: 0.3× input tokens, clamped
extract_output_ratio = 0.3
extract_output_min = 512
extract_output_max = 8192

# Generation output: fixed ceiling per concept (expansion, not compression)
gen_output_max = 16384

# Overview output: 0.1× total source tokens, clamped
overview_output_ratio = 0.1
overview_output_min = 256
overview_output_max = 4096

# Verification output: 0.2× excerpt tokens, clamped
verify_output_ratio = 0.2
verify_output_min = 256
verify_output_max = 4096

# Lint output ceiling (tokens)
lint_output_max = 8192

# WiCER probe/eval output ceilings (tokens)
wicer_probe_output_max = 4096
wicer_eval_output_max = 4096

# ── LLM settings ────────────────────────────────────────────────────────

[compile.llm]
# Primary model in litellm format ("provider/model")
default_model = "ollama/llama3.2"

# Vision model for captioning IMAGE chunks during resolution.
# When set, VLMEnricher is added to the resolver chain.
# vlm_model = "openai/gpt-4o"

# Ordered fallback models tried when the primary fails
# fallback_chain = ["openai/gpt-4o", "anthropic/claude-3-haiku-20240307"]

# Context window discovery:
# The context window (max_input / max_output tokens) is discovered
# automatically at startup from litellm or Ollama /api/show. If discovery
# fails, these fallback values are used:
# fallback_max_input = 8192
# fallback_max_output = 4096

# Safety rails for discovered context window:
# num_ctx_min = 2048      # minimum context window to accept
# num_ctx_max = 131072    # maximum context window to accept

# Transient-error retries before advancing to next fallback model
fallback_max_retries = 2

# LLM call timeout
timeout = 120.0

# ── Embedding settings ──────────────────────────────────────────────────

[compile.embedding]
# model = "granite-embedding:278m"
# provider = "auto"
# dim = 384

# ── Output settings ─────────────────────────────────────────────────────

[compile.output]
# Markdown flavor: obsidian | gfm | mkdocs | mdx | quarto | myst | standard
# Set to auto-detect when omitted.
# flavor = "obsidian"

# Max related-links per page in vault mode (0 = unlimited)
# max_related_links = 15

# Default frontmatter fields added to every page
# [compile.output.frontmatter]
# language = "en"
# domain = "ml"

# ── Lint settings ───────────────────────────────────────────────────────

[lint]
# Rules to run (null = all structural rules)
# enabled = ["broken-wikilinks", "orphan-page", "duplicate-title"]

# Exit with error if health score falls below this threshold
# threshold = 80

# ── Eval settings ───────────────────────────────────────────────────────

[eval]
# CI gate: exit non-zero if score below threshold
# threshold = 80

# Number of historical eval results to keep
history_size = 20

# ── Trust settings ──────────────────────────────────────────────────────

[trust]
# Privacy redaction filter: strip secrets/PII before sources enter the pipeline
# privacy_filter = true

# ── Ignore patterns ─────────────────────────────────────────────────────

[ignore]
# Glob patterns excluded from source discovery
# patterns = ["*.tmp", ".drafts/", "*.bak"]

# ── Event hooks ─────────────────────────────────────────────────────────
# Register Python callables that fire on pipeline events.
# Each value is a list of "module:attribute" import paths.
# Events: pre_compile, post_compile, on_capture, on_query, on_lint

[hooks]
# post_compile = ["mypkg.hooks:auto_lint"]
# on_capture = ["mypkg.hooks:notify"]
# on_query = ["mypkg.hooks:log_query"]
