# kompend configuration reference
# Copy to .kompend/config.toml or kompend.toml and adjust for your project.
# Full docs: https://kompend.readthedocs.io/guides/config.html

# ── Paths ────────────────────────────────────────────────────────────────
# All paths are relative to the wiki root (the directory containing
# `.kompend/config.toml` or `kompend.toml`, or the value of `--wiki-dir`).

[paths]
# Root directory for resolving all relative paths. When unset, uses
# the directory containing this config file, or the value of --wiki-dir.
# wiki_dir = "."
sources_dir = "sources"
output_dir = "wiki"
cache_dir = ".kompend/cache"
state_dir = ".kompend"
# Discover sources in subdirectories of sources_dir. Set false for a flat
# vault: only files directly in sources_dir are indexed.
# CLI: --recursive / --no-recursive   Env: KOMP_PATHS_RECURSIVE
recursive = true

# ── User notes ──────────────────────────────────────────────────────────
# Free-form context file injected into LLM templates as {{ user_notes }}.
# Kompend never modifies this file. Missing file = no error.

[notes]
file = "NOTES.md"

# ── Ingestion settings ──────────────────────────────────────────────────
# There is no parser selector. parsecraft is the ingestion pipeline: it routes
# each page across its own sub-backends (native, docling, liteparse, pandoc, OCR)
# and is the only parser path kompend has. What remains configurable below is
# parsecraft's own parameters, passed through unchanged.
#
#   uv add kompend[parsecraft]      — the pipeline itself
#   uv add kompend[mineru]          — adds the MinerU 4.x engine via
#                                  parsecraft[mineru]; licence opt-in (ADR-0007)
#   uv pip install marker-pdf    — bring-your-own PDF engine, detected by import
#                                  (ADR-0006); PDF pages only
#
# See docs/guides/document-extraction.md, and `kompend list-parsers` for the
# sub-backends in use.

[ingest]

# ── parsecraft judge tier (only used when parser = "parsecraft") ────────
# parsecraft routes each page across its own backends. With the judge
# disabled it uses a deterministic rule table (format + VRAM + intent). With
# a judge enabled it asks a System One model to re-rank the candidates the
# hard constraints already admitted, weighting speed against quality per
# page. That is what keeps a text-native PDF on the fast path while a
# scanned, table-heavy one moves to a strong backend.
#
#   none        (default) — deterministic rule table, no model, no network
#   ollama      — local ollama daemon; the model MUST advertise the
#                 "decision" capability (ollama show <model>), e.g.
#                 parable-tinyjev or tev1. Completion-only GGUFs are
#                 rejected by the daemon with HTTP 400.
#   zen         — https://opencode.ai/zen; needs OPENCODE_API_KEY
#   typesafe-ai — TypeSafe cloud; needs TYPESAFE_API_KEY
#
# The model token is the SDK's name for the provider: for ollama the bare
# ollama model name (no ":tag" suffix — the SDK reads that as a variant and
# rejects it), for the cloud providers their published model id.
# A judge that cannot be reached, or that fails mid-run, degrades to the
# rule table with a WARNING instead of failing the ingest.
# Env: KOMP_INGEST_PARSECRAFT_JUDGE
# parsecraft_judge = "none"  # ollama, zen, typesafe-ai
# Env: KOMP_INGEST_PARSECRAFT_JUDGE_MODEL
# parsecraft_judge_model = ""
#
# Ranking axis when several candidates tie on the constraint check:
#   speed    — prefer the cheapest eligible backend
#   balanced (default) — prefer capability, bounded by the host budget
#   quality  — prefer the strongest eligible backend
# Env: KOMP_INGEST_PARSECRAFT_PREFERENCE
# parsecraft_preference = "balanced"  # speed, quality
#
# MinerU conversion effort. The validated set mirrors parsecraft's own
# `BackendConfig.options["effort"]` choices:
#   flash    — verified default; weight-free CPU work on text PDFs.
#   medium   — intermediate; loads parts of the MinerU pipeline.
#   high     — VLM path; emits equations, tables and figure captions that
#              `flash` skips. Loads MinerU's VLM checkpoint (~1.2B params).
#   xhigh    — VLM path at the highest quality setting.
# `flash` is the schema default. The value is read, validated and fingerprinted
# at construction; it reaches the mineru backend only once parsecraft's executor
# routes `BackendConfig.options` through `RoutingConstraints.backend_options`.
# Until then it flips the parse cache key on every change but is otherwise
# configured-but-inert.
# Env: KOMP_INGEST_PARSECRAFT_EFFORT
# parsecraft_effort = "flash"  # medium, high, xhigh
#
# Whether parsecraft may route a page to an OCR sub-backend.
#   unset (default) — parsecraft derives it: OCR is permitted when an `ocr-*`
#                     extra is installed OR the host has a usable OCR engine.
#   false           — ban OCR outright. An all-native corpus should: a blank
#                     or faint page otherwise pays a full GPU VLM pass.
#   true            — permit OCR regardless of the derivation.
# The value is part of the parse-cache fingerprint, so changing it re-parses.
# Env: KOMP_INGEST_PARSECRAFT_ALLOW_OCR
# parsecraft_allow_ocr = false
#
# Restrict the external engines parsecraft may use, overriding the probed
# set. Empty (the default) keeps the probe's answer. Names are parsecraft's
# own engine ids — open capability data, so a list of strings rather than a
# closed enum. The env form is a comma-separated list.
# Env: KOMP_INGEST_PARSECRAFT_ENGINES
# parsecraft_engines = ["mineru", "marker"]
#
# Ask liteparse to recover table structure from a page's vector graphics.
# With it on, parsecraft populates StructuredChunk.rows and a table arrives
# as structured list[list[str]] instead of a Markdown grid. A page with no
# vector records still yields no table, and the option is inert on pages
# another backend serves.
# Env: KOMP_INGEST_PARSECRAFT_EXTRACT_VECTOR_GRAPHICS
# parsecraft_extract_vector_graphics = true
#
# Backend override — rank one backend first where it is eligible, or pin the
# document to one exclusively. parsecraft owns routing; this passes a single
# preference or pin through to it rather than rebuilding a routing list.
#   preferred_backend — a preference, never a guarantee: a page the named
#                       backend cannot serve still falls back.
#   only_backend      — a hard pin: pages it cannot *cover* fail loudly; a
#                       blank page still degrades (coverage ≠ content).
# Names are validated against parsecraft's registered backends at config load,
# and both are part of the parse-cache fingerprint. Useful to pin a
# layout-aware backend for a table-heavy corpus, or to route around a defect
# in the leading backend without uninstalling anything.
# Env: KOMP_INGEST_PARSECRAFT_PREFERRED_BACKEND
# parsecraft_preferred_backend = "mineru"
# Env: KOMP_INGEST_PARSECRAFT_ONLY_BACKEND
# parsecraft_only_backend = "mineru"

# Per-backend options forwarded to parsecraft, e.g.
#   {backend_name: {option_key: option_value}}
# Keys must match parsecraft's registered backends; values are
# str | int | float | bool. A user option wins over the option kompend
# derives from the other [ingest] keys. Part of the parse-cache fingerprint.
# Env: KOMP_INGEST_PARSECRAFT_BACKEND_OPTIONS
# parsecraft_backend_options = { mineru = { effort = "high" } }

# ── Downloader settings ─────────────────────────────────────────────────
# Controls how URLs are fetched. URLs whose path looks like HTML (no
# extension, .html/.htm/.aspx/.php/.jsp, or trailing /) go through the
# browser-based WebCrawler (crawl4ai); everything else (PDF, DOCX, …)
# goes through the direct HTTPDownloader (urllib).
# Env: KOMP_DOWNLOADER_UNDETECTED

[downloader]
# Undetected-browser mode (Patchright + real Edge/Chrome). Default ON.
# Stronger Cloudflare / bot-protection bypass than stealth alone. Stealth
# (playwright-stealth) is always enabled as the fallback. Falls back to
# stealth automatically when no Edge/Chrome installation is found.
# No effect on the direct HTTPDownloader path used for PDF/binary URLs.
# undetected = true

# ── Export settings (kompend sources export) ──────────────────────────────

[export]
# Where extracted knowledge lands when exporting a source to markdown.
# Values: off (skip) | inline (markdown section) | asset (extracted.json in
# the export's assets directory). Overridable per run with --annotations /
# --summary on `kompend sources export`.
annotations = "inline"   # off, asset
summary = "inline"       # off, asset

# ── Display settings ────────────────────────────────────────────────────

[display]
# Truncation limits for rendered sections (index, related-titles list,
# log messages, excerpts). Increase to see more, decrease for compact output.
source_names = 20         # max sources shown in compiled-wiki index
related_titles = 15       # max related-titles links in write/capture pages
doc_headings = 5          # max headings in one-line document summary
concept_names = 3         # max concept names sampled in extraction log
memory_entries = 10       # max memory entries in system context
excerpt_chars = 300       # max chars per excerpt in concept pages / chunk preview
description_max_chars = 200 # max chars of a page description (index entry + frontmatter)
cli_element_chars = 80    # max chars per parsed-element preview in CLI output
tier_sample_size = 5      # max sources in tier-state sample (`kompend compile --list-tiers`)
cli_arg_preview = 4       # max CLI args shown in the run-log command preview
log_error_chars = 500     # max chars of an error string in the run-log JSONL
lint_feedback_chars = 200 # max chars of lint feedback embedded in a finding
memory_query_chars = 50   # max chars of a query string in the memory-store info log
mcp_element_chars = 500   # max chars per parsed element in the MCP `parse_document` response
web_nodes = 10            # max nodes shown in the web server's node preview
search_snippet_chars = 300 # max chars of a search-result snippet (RAG / RRF / hybrid)

# ── Custom providers ─────────────────────────────────────────────────────
#
# Define OpenAI-compatible endpoints that are not natively supported by
# pydantic-ai or listed in the models.dev catalog.  Each provider gets a
# short name that becomes the ``provider/`` prefix in model strings.
#
# RECOMMENDED: define providers globally in ~/.config/kompend/config.toml —
# they carry credentials and are usually machine-wide, not per-vault.
#
# Example — self-hosted llama.cpp server:
#
#   [providers.my-llama]
#   base_url = "http://localhost:8081/v1"
#   api_key = "${MY_API_KEY}"            # optional; resolved from env var
#   api_type = "openai-chat"             # openai-chat (default) | openai-responses | anthropic
#   context_window = 32768               # default context window for all its models
#
#   # Per-model context window (finest granularity, wins over provider-level):
#   [providers.my-llama.models."mistral-nemo"]
#   context_window = 131072
#
# Then use it in [compile.llm]:
#
#   default_model = "my-llama/mistral-nemo"
#
# The ``api_key`` value supports ``${VAR_NAME}`` env-var references.
# If omitted, a placeholder key is sent (works for keyless endpoints).
# ``context_window`` overrides auto-discovery.

# ── Compile settings ────────────────────────────────────────────────────

[compile]
# Compiler backend: graph (heading-based extraction) | wicer (iterative compile-evaluate-refine).
# Both wrap the TwoPhaseCompiler, which runs bibliographic reference extraction
# as a pre-pass before the main extraction phase.
compiler = "graph"  # wicer

# Image handling: file (extract to disk) | base64 (inline)
image_mode = "file"  # base64

# VLM caption pre-filter: images below these thresholds (bytes / pixels) are
# skipped as decorative noise (logos, icons, spacers) without a VLM call.
# vlm_min_image_bytes = 2048
# vlm_min_image_dimension = 64

# Pipeline start tier: index | chunk | resolve | compile | output
# start_at_tier = "index"  # chunk, resolve, compile, output

# Pipeline stop tier: index | chunk | resolve | compile | output
# stop_at_tier = "output"  # index, chunk, resolve, compile

# Parallel parse workers (1 = sequential)
workers = 1

# Source tags applied during indexing (auto-tags via CLI or manually here).
source_tags = []

# Honor .gitignore in sources_dir (skip ignored files during index/ingest).
respect_gitignore = true

# Tier state file (None = base_dir/.kompend/compile_state.json).
# tier_state_file = "compile_state.json"

# Force re-run all stages even if cached
# force = false

# Bypass cache entirely
# no_cache = false

# Enable review mode (gate compilation on review approval)
# review = false

# Bypass review gate
# bypass_review = false

# Enable provenance tracking
# provenance = false

# Enable private page handling
# private = false

# Enable LLM verification of compiled content
# verify = false

# Enable synthesis of overview pages
# synthesize = false

# Enable vector index build
# index = true

# Enable lint during compile
# lint = false

# Keep source files at their original location instead of copying to sources/.
# URLs/downloads are always copied. Files already inside sources/ are left as-is.
# CLI: --in-place
# in_place_sources = false

# ── Memory lifecycle ──────────────────────────────────────────────────────
#
# kompend tracks a lifecycle state per wiki node across compiles:
#   - confidence (evolves toward 1.0 with each re-compile)
#   - tier (working → episodic → semantic → procedural)
#   - supersession (old nodes replaced by same-title new nodes)
#   - retention/decay (exponential forgetting curve)
# Disabled by default to keep first-run output clean.
# memory_enabled = true
# memory_half_life_days = 90.0
# memory_decay_threshold = 0.3

# ── Budget settings ───────────────────────────────────────────────────────
#
# All budgets are in TOKENS (not characters). Approximate conversion:
# 1 token ≈ 4 characters for English text.
#
# Input sizing is adaptive: the context window is discovered from the
# model at startup (via pydantic-ai's model info or Ollama /api/show).
# Chunks fill the available context window, clamped to [chunk_size_min,
# chunk_size_max]. The system NEVER silently truncates input.
#
# Output sizing: there is none. kompend never sends a max_tokens ceiling;
# an answer is bounded by the context window minus its prompt. The planners
# reserve a quarter of the window (max 8192 tokens) for the answer and use
# the rest for input - see ContextWindow.answer_reserve.

[compile.budget]
# Structural controls (not token budgets)
concepts_per_batch = 8         # concepts per generation batch
verify_min_ngram = 3           # minimum n-gram for substring verification
# WiCER refinement rounds: 0 = run until the loop converges (no probes, no
# new facts, all probes pass) or the wall-clock budget below is spent.
# A positive value is an explicit user-set limit.
wicer_max_iterations = 0
# WiCER wall-clock budget (seconds) — a timeout-class stop, not a size cap.
wicer_max_seconds = 1800
# Warning thresholds — they never exclude content. Short or numerous pages
# are still compiled; only pages without any body text are dropped.
min_content_length = 50        # warn below this many body chars (after stripping headings)
min_concept_sources = 2        # min distinct sources for an entity to get a concept page
max_concept_pages = 50         # warn above this many auto-generated concept pages

# Chunk sizing safety rails (tokens)
chunk_size_min = 2048          # floor: prevents useless tiny chunks
chunk_size_max = 131072        # ceiling: safety rail for models claiming 1M+ context

# Node summarization (hierarchical chunk tree internal nodes)
# Longer content is split into several calls (slower, but no content is
# lost) — it is never truncated.
summary_max_content_chars = 8000
# Characters per payload window of the agentic summarizer. One window costs
# one summarize call, so a bigger window means fewer calls (faster) — it never
# drops content. Raise it for small-context models only carefully: the whole
# window is sent to the model.
summary_window_chars = 2000
summary_target_chars = 600
summary_skip_single_child = true
# Max chunks before switching from two_level to multi_resolution strategy
summary_chunk_threshold = 10
# LLM requests budgeted per node in an agentic summarizer session
# (one next_node() turn + one summarize_node() turn). Raise for models that
# need extra turns before they reach a tool call.
summary_requests_per_node = 2
# Agentic summarizer sessions: nodes per session, and how many extra attempts
# a session that records nothing gets before its nodes are left unsummarized.
# Smaller batches bound the blast radius of a model that stops calling tools.
summary_session_batch_size = 20
summary_session_stall_retries = 1

# Capture / write-page synthesis: characters served per source window.
# A longer source is read in several windows — it is never shortened.
capture_source_char_max = 4000

# Concept dedup thresholds (Phase 1 — name+definition embedding merge)
concept_merge_threshold = 0.82       # cosine similarity to merge concepts
concept_string_merge_threshold = 0.70  # Jaccard fallback when no embeddings
jaccard_min_token_len = 1            # ignore tokens shorter than this in Jaccard
edge_min_title_len = 4               # min title chars to create a cross-source edge

# ── LLM settings ────────────────────────────────────────────────────────

[compile.llm]
# Primary model in "provider/model" format (e.g. "ollama/qwen3",
# "openai/gpt-4o", "anthropic/claude-opus-4-6").
default_model = "${KOMP_LLM_DEFAULT_MODEL}"

# Vision model for captioning IMAGE chunks during resolution.
# When set, VLMEnricher is added to the resolver chain.
# vlm_model = "${KOMP_VLM_MODEL}"
# vlm_model = "openai/gpt-4o"

# Ordered fallback models tried when the primary fails
# fallback_chain = ["openai/gpt-4o", "anthropic/claude-3-haiku-20240307"]

# Context window discovery:
# The context window (max_input / max_output tokens) is discovered
# automatically: [providers.<name>] override → Ollama /api/show →
# models.dev catalog. If discovery fails, these fallback values are used:
# fallback_max_input = 8192
# fallback_max_output = 4096

# User-configured context window override/cap (tokens).
# When set, max_input and max_output are capped to this value regardless
# of what Ollama or models-dev report. Useful for limiting context usage
# on slower/local models. None = no cap (use full discovered window).
# context_window = 65536

# LLM communication data format for prompt input context: "json" (default) | "toon" | "ison"
# Compact formats reduce input token count by 30-70%, giving small-context models
# more output budget and reducing truncated/malformed responses. Every compact
# payload carries a short syntax specification, so the model can read it.
# LLM output always uses JSON regardless of this setting — the API-level
# response_format guarantee is preserved.
# Run "kompend doctor" to check whether your model handles a format at all.
# Packages (core deps, already installed): toon_format (TOON), ison-py (ISON)
# data_format = "json"  # toon, ison, text

# Agent notebook (memory capability) for the stages where one agent instance
# handles many outputs: summarisation, verification, remediation, distillation.
# Stages that build a fresh agent per unit (generation, capture, query,
# indexing) gain nothing — the notebook dies with the agent.
# agent_memory = false

# LLM call timeout (seconds)
timeout = 120.0

# PydanticAI output retries (retries when LLM output fails schema validation)
output_retries = 2

# Tool-call retry budget (retries when a tool raises ModelRetry — a missing
# file, an invalid argument). Independent of the output-validation budget:
# a flaky tool can be given more trials without granting the model more
# schema-validation attempts. One hallucinated tool call must not abort a
# run, so the default is 3.
tool_retries = 3

# Output-validation retry budget for tool-based (agentic) agents. Defaults
# higher than output_retries because agentic agents run multi-turn loops
# (fetch concepts, read segment, generate) where each turn can be
# invalidated; small models routinely need more than 2 output retries there.
agentic_output_retries = 4

# Rolling window (in output tokens) for the short-term tok/s rate reported
# in progress and log lines. Default 1000.
throughput_window_tokens = 1000

# Enable/disable output retries. When disabled, the agent gives up immediately
# on schema validation failure rather than retrying with a correction prompt.
# Disabling can help small models (<3B params) that spin on retry loops.
# output_retries_enabled = true

# Delta retry: when the model returns partially valid structured output,
# extract the valid parts and ask the model to fix only the broken ones,
# instead of regenerating everything from scratch. Recommended for large
# models (>7B); disable for small models that struggle with structured output.
# delta_retry_enabled = true

# Batch failure threshold: when a model fails more than this fraction of
# extraction batches (after per-batch retries), compilation stops early.
# batch_failure_threshold_ratio = 0.5
# batch_failure_threshold_min = 5

# Per-batch retry attempts: when an extraction batch fails (returns no result
# after internal agent retries), retry the batch this many additional times
# before counting it as failed. Set to 0 to disable per-batch retries.
# batch_retry_attempts = 3

# Slug max length for concept page filenames. Windows limits path components
# to 255 chars; LLMs sometimes emit full sentences as titles.
# slug_max_length = 80

# Chars-per-token heuristic for budget estimation. Also overridable via the
# KOMP_CHARS_PER_TOKEN environment variable.
# default_chars_per_token = 3.85

# Minimum input tokens per generation segment. Prevents absurdly tiny segments
# when the model's context window is small.
# min_segment_tokens = 512

# Reasoning effort: controls how much the model "thinks" before responding.
# Supported values: "none", "minimal", "low", "medium", "high", "xhigh", "default".
# For Ollama models, "none"/"minimal"/"low" also set think=False.
reasoning_effort = "none"  # minimal, low, medium, high, xhigh, default

# Extraction strategy for multi-chunk sources:
# - "incremental" (default): feeds chunks sequentially into one agent
#   conversation via message_history, so each batch sees accumulated
#   context from prior batches within the same document. History is
#   compacted when its token estimate exceeds 2x the answer reserve
#   (oldest batches dropped first) so the context window never
#   overflows — which would otherwise cause empty model responses.
# - "reduce": map-reduce — extract each batch independently, then a
#   second LLM pass merges partial results into a coherent
#   document-level extraction.
# - "agentic": stateful — one agent per source walks sections in
#   order, accumulating a structured ExtractionMemory (concepts,
#   entities, tags) with explicit compaction (drop ref_count==1,
#   keep last 3 section summaries, strip definitions on survivors).
#   Cross-section context is injected as a compact SystemPromptPart
#   digest rather than raw message history, so it stays bounded
#   regardless of document length. Best coherence for long/high-value
#   sources; source-level cache only (no per-batch cache).
extraction_strategy = "incremental"  # reduce, agentic

# Context-window management for multi-turn / multi-batch agents
# (WiCER probe/judge loops; NOT incremental extraction, which has its
# own compaction). When the conversation history nears the model's
# context budget, `summarization-pydantic-ai` compresses it via an
# LLM summary rather than dropping messages.
#   "default"    — compress at 90% of the context window (recommended)
#   "aggressive" — compress at 70%, keep 5 trailing messages
#   "sliding"    — trim oldest messages at 100, keep 50 (no LLM call)
#   false        — disable (history preserved verbatim)
context_manager = "default"  # aggressive, sliding, false

# RLM (Recursive Language Model) — lets agents explore large contexts by
# writing Python code in a sandboxed REPL instead of packing everything
# into the prompt. Composes with context_manager above.
[compile.llm.rlm]
enable = false                    # on/off switch
# max_tool_calls = 50             # tool-call budget for the whole run (UsageLimits)
# code_timeout = 60.0             # seconds per code execution
# sub_model = "ollama/gpt-oss:20b"  # llm_query sub-model (default: main model)
# max_depth = 2                   # rlm_query recursion depth (0 = non-recursive)
# node_budget = 32                # total recursive rlm_query calls per root run

# Per-role model overrides — use a different model for specific LLM roles.
# Keys are LLMRole enum values (see kompend.llm.roles.LLMRole).
# Common roles: "compile.extract", "compile.generate", "wicer.probe",
# "wicer.judge", "vlm", "search.crag", "search.hyde", "synthesize",
# "verify", "capture", "organize.categorize", "doctor", "agent".
# When a role is not listed here, the default_model is used.
# [compile.llm.role_models]
# "compile.extract" = "ollama/gpt-oss:20b"
    # "compile.generate" = "openai/gpt-4o"
    # "vlm" = "openai/gpt-4o"
    # "wicer.judge" = "anthropic/claude-sonnet-4-20250514"

# ── Skills ──────────────────────────────────────────────────────────────
# User-defined skill instructions injected into agent system prompts.
# Skills are appended to the system prompt as additional context under
# a "## Skill: <name>" heading. All PydanticAI agents receive the same
# set of skills — they are pipeline-global, not per-agent.
# See docs/reference/pydantic-ai-agents.md for the full guide.

[compile.skills]

# Example: domain terminology cheat-sheet for extraction + generation
# [compile.skills."domain-terms"]
# instructions = '''
# - VAD: Voice Activity Detection
# - NR: Noise Reduction
# - DOA: Direction of Arrival
# '''

# ── Category extraction ──────────────────────────────────────────────────

# Extra page kinds beyond the mandatory taxonomy. Mandatory kinds (always
# extracted, cannot be deactivated or overridden):
#   concept      — a topic, idea, or approach (default)
#   entity       — a named thing: standard (P.863), body (ITU-T), product, person
#   summary      — a digest of what one significant source contributes
#   comparison   — evaluates alternatives ("X vs Y"): dimensions, verdict, evidence
# Each extra maps a kind name to the prompt instruction telling the LLM when
# to emit it and what the page must contain.
# [compile.extraction.categories]
# procedure = "Step-by-step how-to pages: prerequisites, numbered steps, verification."

# Example: style guide for wiki generation
# [compile.skills."style-guide"]
# instructions = '''
# - Use sentence-case for page titles
# - Cross-link related concepts with [[wikilinks]]
# - Prefer active voice
# '''

# ── Embedding settings ──────────────────────────────────────────────────

[compile.embedding]
# Embedding model for semantic search / RAG. Empty (default) = no embedding /
# no vector index. Set KOMP_EMBEDDING_MODEL in your environment, or uncomment
# and set below. A provider prefix is required — there is no local fallback.
# Format: "<provider>:<model>" (pydantic-ai Embedder format: openai, ollama,
# google, cohere, etc.)
# model = ""
# model = "ollama:granite-embedding:278m"

# Embedding batch size (number of texts to embed per API call)
# batch_size = 10

# ── Output settings ─────────────────────────────────────────────────────

[compile.output]
# Output format: markdown (default, OKF v0.2-compliant) | json | typst
# OKF (Open Knowledge Format) is NOT a format — it is the compliance spec
# the default markdown output follows: compliant frontmatter, portable
# relative links, reserved files (index.md, log.md), §5.1 footnotes.
# format = "markdown"  # json, typst

# Markdown flavor: obsidian | gfm | mkdocs | mdx | quarto | myst | standard
# Set to auto-detect when omitted.
# flavor = "obsidian"  # gfm, mkdocs, mdx, quarto, myst, standard

# Max related-links per page in vault mode (0 = unlimited)
# max_related_links = 15

# Default frontmatter fields added to every page
# [compile.output.frontmatter]
# language = "en"
# domain = "ml"

# Path to the rumdl configuration file for this vault. Defaults to
# .kompend/rumdl.toml (auto-materialized from the shipped default on first
# use — edit that copy to override). Applies to compile-time formatting
# (rumdl fmt), the `rumdl` lint rule (check/fix), and `kompend lint format`.
# rumdl_config = ".kompend/rumdl.toml"

# ── Dedup settings ────────────────────────────────────────────────────────
# Content-level duplicate detection for ingested sources. When enabled, each
# parsed document is compared against all previously ingested documents using
# embedding similarity and/or MinHash signatures. Documents with >95%
# similarity are flagged as "identical" and excluded from compilation.

[dedup]
# enabled = false
# matchers = "embedding,minhash"  # embedding, minhash
# threshold_identical = 0.95
# threshold_similar = 0.80
# Embedding model override. Empty string "" is treated as unset — falls
# back to compile.embedding.model, then all-MiniLM-L6-v2 (local HuggingFace model).
# model = ""
# minhash_lsh_threshold = 0.8

# ── Organize settings ───────────────────────────────────────────────────
# LLM-driven file categorization for `kompend organize`. Requires a prior
# `kompend compile` run so extractions are available in `.kompend/cache/extract/`.

[organize]
# Maximum directory depth for the proposed tree (1-4).
# max_depth = 3

# Minimum sub-categories at any level; fewer promotes children up.
# min_subcategories = 2

# Minimum number of source files per leaf category; smaller leaves are
# merged into their parent. Must be >= 1. Values larger than the document
# count degrade gracefully to a near-flat layout.
# min_files_per_category = 2

# Collapse single-file sub-categories into the parent directory.
# collapse_single_file = true

# ── Lint settings ───────────────────────────────────────────────────────

[lint]
# Rules to run (null = all structural rules)
# enabled = ["broken-wikilinks", "orphan-page", "duplicate-title"]

# Cosine-similarity threshold for reference fuzzy dedup (0.0–1.0).
# fuzzy_threshold = 0.85

# Model override for LLM-powered lint steps (factual-consistency, clarity-score,
# coverage-gap, contradiction-detection). Falls back to compile.llm.default_model.
# model = "openai/gpt-4o-mini"

# ── Trust settings ──────────────────────────────────────────────────────

[trust]
# Privacy redaction filter: strip secrets/PII before sources enter the pipeline
# privacy_filter = true
# Record the OS user (ingested_by / memory_by) in provenance metadata.
# Disable on shared wikis that must not store user identity.
# CLI: --no-user-tracking   Env: KOMP_USER_TRACKING=false
# user_tracking = true

# ── Ignore patterns ─────────────────────────────────────────────────────

[ignore]
# Glob patterns excluded from source discovery
# patterns = ["*.tmp", ".drafts/", "*.bak"]

# ── Search / RAG settings ──────────────────────────────────────────────
# Enhanced retrieval pipeline features. All default to disabled.
# Each is an optional plug-in step — enable only what you need.

# ── Attachment settings ──────────────────────────────────────────────
# Auto-adoption: files dropped into attachments/<slug>/ without a manifest
# entry are registered at compile start. With ingest_adopted = true (default)
# text/image files also become ingestible (parsed at compile); false =
# register only. embed includes attachment content in the vector index
# (replaces the deprecated search.embed_attachments).

[attachments]
# ingest_adopted = true
# embed = false

[search]

# Multi-query expansion (RAG-Fusion): generate N query variants via LLM,
# retrieve independently for each, then merge via RRF. Improves recall
# for ambiguous or under-specified queries.
# expansion.enabled = false
# expansion.variants = 3

# CRAG (Corrective RAG): LLM grades each retrieved chunk for relevance.
# Chunks below threshold are dropped before synthesis.
# crag.enabled = false
# crag.threshold = 0.3

# Neural re-ranker: bi-encoder cosine-similarity re-ranks top-K
# candidates. Uses the same embedding model as the vector store.
# reranker.enabled = false
# reranker.model = "all-MiniLM-L6-v2"
# reranker.top_k = 20

# HyDE (Hypothetical Document Embeddings): for sparse queries, generate
# a hypothetical answer first, then use its embedding for retrieval.
# hyde.enabled = false

# Contextual Retrieval: during T2 chunking, prepend situating context
# to each chunk before embedding. Improves both compilation and query.
# contextual.enabled = false
# contextual.model = ""

# Agentic query (opt-in): the query agent searches the wiki itself via
# search_wiki/read_page tools instead of retrieve-then-synthesize.
# agentic.enabled = false
# agentic.model = ""
# agentic.max_sub_questions = 5

# Synthesis verbosity: controls the length and depth of `kompend query` answers.
#   brief         = a few sentences, essential point only (~300 tokens)
#   standard      = balanced, useful length (~800 tokens, default)
#   comprehensive = thorough, covers all relevant aspects (~2000 tokens)
# Token budgets are clamped to the model's max_output so small models are
# never asked for more than they can produce.
# synthesis.verbosity = "standard"  # brief, comprehensive

# Whether ingestible attachments (text/image captions) are included in
# the vector index. When false, attachment content is parsed and compiled
# but not embedded. Per-attachment overrides via `kompend attachments add --embed/--no-embed`.

# ── Query settings ───────────────────────────────────────────────────────
# Default output format for `kompend query`. Override per-run with --format.
# text = human-readable prose (default)
# json = structured {answer, citations}, pretty-printed
# toon / ison = compact structured encodings for LLM/agent consumers
#   (30-70% fewer tokens than json)
[query]
# format = "text"  # json, toon, ison
